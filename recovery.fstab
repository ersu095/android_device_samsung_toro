# mount point	fstype		device

# there is no actual sdcard in this thing...
#/sdcard		vfat		/dev/block/platform/sprd-sdhci.0/mmcblk0p1
/system		yaffs2		/dev/mtd/mtd11
/cache		yaffs2		/dev/mtd/mtd13
/data		yaffs2		/dev/mtd/mtd12
/misc 		mtd 		/dev/mtd/mtd14
/boot		mtd		/dev/mtd/mtd9
/recovery	mtd		/dev/mtd10
/2ndbl		mtd		/dev/mtd/mtd1
/modem		mtd		/dev/mtd/mtd3
